# Server-side secrets. Copy to .env for Cloud Functions / Cloud Run.
# Never commit a real .env. Never put these values in the Flutter app.

GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live

LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud

# Set to true in production so callable HTTP handlers reject missing App Check tokens.
ENFORCE_APP_CHECK=false
